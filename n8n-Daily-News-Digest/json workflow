    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.data || '';\nconst text = raw.replace(/\\\\n/g, '\\n');\nconst parts = text.split(/\\n\\s*\\n/).map(p => p.trim()).filter(Boolean);\n\nconst head = (parts[0] || '').split('\\n').map(l => l.trim());\nconst greeting = head[0] || 'Hello!';\nconst subline = head[1] || \"Here's today's news\";\nconst themes = (head[2] || '').replace(/<\\/?b>/g, '');\n\nconst stories = parts.slice(1).filter(p => p.startsWith('•'));\nconst linkStyle = 'color:#0b6e8a;font-weight:bold;text-decoration:none;';\n\nlet cards = stories.map(s => {\n  const body = s.replace(/^•\\s*/, '').replace('<a href=', `<a style=\"${linkStyle}\" href=`);\n  return `<tr><td style=\"padding:0 0 14px 0;\">\n    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#ffffff;border-left:4px solid #d8c88a;\">\n      <tr><td style=\"padding:16px 18px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:24px;color:#333333;\">${body}</td></tr>\n    </table></td></tr>`;\n}).join('');\n\nif (!cards) {\n  cards = `<tr><td style=\"background-color:#ffffff;padding:18px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:24px;color:#333333;\">${text.replace(/\\n/g, '<br>')}</td></tr>`;\n}\n\nconst html = `\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#eef2f5;\">\n <tr><td align=\"center\" style=\"padding:24px 12px;\">\n  <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:100%;\">\n   <tr><td align=\"center\" style=\"background-color:#0b2e3c;padding:36px 24px;\">\n     <div style=\"font-family:Arial,Helvetica,sans-serif;font-size:13px;letter-spacing:3px;color:#d8c88a;text-transform:uppercase;\">Daily News Briefing</div>\n     <div style=\"font-family:Arial,Helvetica,sans-serif;font-size:30px;line-height:38px;font-weight:bold;color:#ffffff;margin-top:14px;\">${greeting}</div>\n     <div style=\"font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:24px;color:#dce8ee;margin-top:8px;\">${subline}</div>\n     <div style=\"font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:22px;color:#d8c88a;margin-top:16px;\">${themes}</div>\n   </td></tr>\n   <tr><td style=\"padding:20px 0 0 0;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">${cards}</table></td></tr>\n   <tr><td align=\"center\" style=\"padding:8px 12px 0 12px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#7a8790;\">\n     Summaries are written by AI from Daily Post Nigeria headlines. Tap Read more for the full story.\n   </td></tr>\n  </table>\n </td></tr>\n</table>`;\n\nreturn [{ json: { html } }];"
      },
