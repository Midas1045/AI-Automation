      "parameters": {
        "jsCode": "const form = $('CV SUBMISSION WEBHOOK').first().json;\nconst name = form['FULL NAME'] || '';                 // capitals, as in your form\n\nlet text = $input.first().json.guardrailsInput || ''; // the Guardrails output field\n\n// Clean up email leftovers such as \"user@<URL>\"\ntext = text.replace(/[\\w.+-]+@(<URL>|[\\w.-]+\\.\\w+)/g, '[EMAIL]');\n\n// Replace each part of the name\nname.split(' ').filter(p => p.length > 2).forEach(p => {\n  const safe = p.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n  text = text.replace(new RegExp(safe, 'gi'), '[CANDIDATE]');\n});\n\nreturn [{ json: { candidate_name: name, cv_text: text } }];"
      },
