      "parameters": {
        "jsCode": "const r = $input.first().json.output;           // the AI's scores\nconst form = $('CV SUBMISSION WEBHOOK').first().json;\n\nconst clamp = n => Math.max(0, Math.min(100, Number(n) || 0));\nconst skills = clamp(r.skills);\nconst experience = clamp(r.experience);\nconst education = clamp(r.education);\nconst achievements = clamp(r.achievements);\n\nconst final_score = Math.round(\n  skills * 0.40 + experience * 0.30 + education * 0.15 + achievements * 0.15\n);\n\nlet stage = 'Not shortlisted';\nif (final_score >= 75) stage = 'Interview';\nelse if (final_score >= 55) stage = 'Maybe';\n\nreturn [{ json: {\n  date: $now.toFormat('yyyy-MM-dd HH:mm'),\n  candidate_name: form['FULL NAME'],\n  application_id: $('CANDIDATE  APPLICATION ID').first().json.applicationId,\n  email: form['EMAIL'],\n  job_applied: form['JOB APPLIED'],              // EDIT: must match your form label exactly\n  skills, experience, education, achievements,\n  final_score, stage,\n  strengths: (r.strengths || []).join('; '),\n  gaps: (r.gaps || []).join('; '),\n  summary: r.summary\n}}];"
      },
